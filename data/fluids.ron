// Fluids (ARCHITECTURE §3 + the matter model). Water is the first entry; oil,
// lava, milk, mud, blood … are content. Rendering (color/absorption/fog) and
// physics (density/viscosity/buoyancy) are data. Stable string ids.
//
// Swim constants (submerged_gravity/sink/swim/factor) are transcribed verbatim
// from player.rs so the buoyancy rewire reproduces today's feel exactly.
[
    (id: "oc:water", name: "Water",
        // Underwater tint (matches sky.rs's blue fog); Beer–Lambert ~30:3:1
        // (physical.rs WATER_ABSORPTION) so red dies first, blue survives.
        color: (0.09, 0.30, 0.55),
        opacity: 0.8,
        absorption: (0.45, 0.05, 0.014),
        fog_distance: 72.0,
        ior: 1.333,
        light_opacity: Some(1),
        density: 1.0,
        viscosity: 0.1,
        submerged_gravity: 10.0,
        sink_speed: 3.5,
        swim_up_speed: 4.5,
        swim_speed_factor: 0.55,
        breathability: 0,
        oxygen_content: 12,
        heat_capacity: 4.18,
        conductivity: 0.6,
        boiling_point: Some(373.0),
        melting_point: Some(273.0),
        // Freezes to ice, boils to steam (cross-registry; ice lands later).
        phase_transition: Some((freeze: Some("oc:ice"), boil: Some("oc:steam")))),

    // Lava: molten rock (~1200 °C). Opaque, glowing, dense and viscous, lethal.
    // Nature's values: density ~2.7× water, basaltic-melt heat capacity 1.45 and
    // conductivity 1.7 (a slow-draining heat battery). Solidifies below ~1000 °C
    // (1273 K): slow cool → basalt, fast quench at water → obsidian glass (G5).
    (id: "oc:lava", name: "Lava",
        // Body/fog tint when submerged: deep orange. Dense, but not blinding —
        // you can still make out the blocks right around you (~3-4 blocks)
        // rather than a flat orange wall at 1.5.
        color: (0.70, 0.20, 0.02),
        opacity: 1.0,
        absorption: (4.0, 4.0, 4.0),
        fog_distance: 4.0,
        ior: 1.5,
        // HDR orange (≈1200 °C blackbody ×3) to drive bloom once self-glow lands.
        emissive: (3.0, 1.26, 0.0),
        roughness: 0.5,
        light_opacity: None,
        light_emission: 15,
        density: 2.7,
        viscosity: 10.0,
        // Thick and dense: you barely sink and climb out slowly (and burn).
        submerged_gravity: 4.0,
        sink_speed: 0.5,
        swim_up_speed: 1.5,
        swim_speed_factor: 0.2,
        breathability: 0,
        oxygen_content: 0,
        // ~1200 °C molten basalt: lethal to stand in (heat hazard).
        temperature: Some(1200.0),
        heat_capacity: 1.45,
        conductivity: 1.7,
        melting_point: Some(1273.0),
        phase_transition: Some((freeze: Some("oc:basalt"), quench: Some("oc:obsidian")))),
]
