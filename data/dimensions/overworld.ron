// The overworld — Earth-like, the default dimension. Values transcribed 1:1
// from the code they replace: gravity from player.rs, the sky colors from
// sky.rs, and an Earth-like geothermal profile. Other planets/moons are
// sibling .ron files that override only what differs.
EnvDef(
    id: "oc:overworld",
    name: "Overworld",
    gravity: 28.0,
    terminal_fall_speed: 60.0,
    jump_speed: 8.4,
    atmosphere: (
        sky_day: (0.47, 0.71, 0.99),
        sky_dusk: (0.82, 0.52, 0.31),
        sky_night: (0.012, 0.018, 0.05),
        zenith_day: (0.18, 0.42, 0.86),
        zenith_night: (0.004, 0.007, 0.022),
        ambient_night: 0.16,
        ambient_day_gain: 0.32,
        ambient_floor: 0.045,
        sun_tilt: 0.25,
        underwater_color: (0.09, 0.30, 0.55),
        underwater_fog_near: 24.0,
        underwater_fog_far: 72.0,
    ),
    // Earth: ~78% N₂, ~21% O₂, ~1% trace, at 101.3 kPa.
    atmosphere_composition: (
        pressure_kpa: 101.3,
        mix: {"oc:n2": 0.78, "oc:o2": 0.21, "oc:co2": 0.01},
    ),
    // Temperature-vs-height curve (°C at world Y, piecewise-linear, clamped
    // beyond the ends). Earth-like and gentle above: ~0.16 °C/block lapse, the
    // survivable band (50 °C hazard onset) ~256 blocks down, rock above safe to
    // mine. Below the hellish top (-352) the geothermal gradient steepens into
    // the molten layer: rock past the Draper point glows, ramping smoothly from
    // dull-red (525 °C) to near-molten orange (1000 °C) where it meets the lava
    // lake (-656). So the deep reads as one continuous incandescent gradient
    // brightening toward the lava — no banding, drawn by the per-vertex emissive
    // term in the geometry pass. Real lava is hotter still (~1200 °C).
    thermal: (profile: [
        (y:  320.0, temp:  -27.2),  // high peaks (≈0.16 °C/block lapse, held above)
        (y:    0.0, temp:   24.0),  // sea level
        (y: -256.0, temp:   50.0),  // hazard onset
        (y: -352.0, temp:  525.0),  // hellish caves top = Draper point: glow begins at 0
        (y: -560.0, temp:  780.0),  // mid hellish: steady orange glow
        (y: -656.0, temp: 1000.0),  // lava-lake boundary: near-molten rock (held below)
    ]),
    // Deep vertical layers (caverns carved & filled; un-carved rock stays
    // stone). Bands run from `top` down to the next band's top, the last to the
    // bedrock floor (y≈-768). The lava casts light + heat (tier-2); the hellish
    // rock glows from its ambient temperature.
    layers: (bands: [
        (top: -352, fill: "oc:air"),   // hellish caves: big hostile caverns
        (top: -656, fill: "oc:lava"),  // lava lake: big lava-filled caverns
    ]),
)
