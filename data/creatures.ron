// Creature kinds (ARCHITECTURE.md §5.6): spawn rules and looks are data so
// mods can add creatures the same way. `size` is (width, height) of the
// collision box in blocks; proportions follow the Minecraft wiki
// (cow 0.9x1.4, sheep 0.9x1.3) as the design reference.
[
    (
        id: "oc:cow",
        name: "Cow",
        size: (0.9, 1.4),
        color: (109, 74, 49),      // brown hide
        accent: Some((211, 200, 186)), // pale face and hooves
        model: "quadruped",
        speed: 1.1,
    ),
    (
        id: "oc:sheep",
        name: "Sheep",
        size: (0.9, 1.3),
        color: (228, 225, 218),    // cream wool
        accent: Some((124, 102, 86)),  // bare face and legs
        model: "quadruped",
        speed: 1.2,
    ),
]
